# v2 新部署无需创建 .env，直接在网页设置。
# 本文件仅用于旧版兼容导入与可选部署参数；不要分享或提交实际凭据。
# 下列业务设置仅在首次初始化网页设置时导入，之后以网页保存的值为准。
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
A_CHAT_ID=-1001111111111
B_CHAT_ID=-1002222222222
CONFIG_PATH=./config/config.json
DATA_DIR=./data
# 调度使用程序内的 Asia/Shanghai，与宿主机时区无关
TZ=Asia/Shanghai
POLL_INTERVAL_SECONDS=15
CATCH_UP_HOURS=72
MAX_ATTEMPTS=6
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=info
# 本地 Node.js 部署可选；Docker 内的地址由 Compose 设置
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8080
# COOKIE_SECURE=true
