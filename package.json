{
  "name": "telegram-bot-hub",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "统一管理多个 Telegram 机器人的后台：可扩展的机器人类型、cron 调度与配置向导",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.js start",
    "setup-key": "node --env-file-if-exists=.env src/cli.js setup-key",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "health": "node --env-file-if-exists=.env src/cli.js health",
    "test": "node --test"
  }
}
