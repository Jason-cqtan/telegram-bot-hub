{
  "name": "telegram-quarterly-renewal-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "北京时间自然季度末私人群续费通知",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.js start",
